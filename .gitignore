# Keystore / Signing — NIEMALS committen!
*.jks
*.keystore
keystore.properties

# ─────────────────────────────────────────────────────────────
# Rust / Cargo (spätere Tectonic-Bindung via cargo-ndk)
# ─────────────────────────────────────────────────────────────
target/
**/*.rs.bk
*.pdb
# Kompilierte native Libs werden beim Build erzeugt, nicht committen:
app/src/main/jniLibs/**/*.so

# biber-Runtime der thesis-Edition: cross-gebaute Binaries + Baum-Zip werden
# extern bereitgestellt (siehe app/src/thesis/README.md), nicht in Git (Blob-Bloat
# + F-Droid-Policy). Der Code (BiberRuntime, Flavor) ist committed; die Artefakte
# müssen vor einem thesis-Build vorhanden sein.
app/src/thesis/jniLibs/**/*.so
app/src/thesis/assets/biber-tree.zip
# Sonden-Binaries (androidTest), ebenfalls extern:
app/src/androidTest/jniLibs/**/*.so
app/src/androidTest/assets/biber-tree.zip

# ─────────────────────────────────────────────────────────────
# Sonstiges
# ─────────────────────────────────────────────────────────────
*.log
.env
.env.local

# Lose Screenshots / generierte Bilder im Repo-Root (nicht committen).
# Bewusst gepflegte Bilder liegen unter docs/ und bleiben getrackt.
/Bildschirmfoto_*.png
/Screenshot_*.jpg
/Screenshot_*.png
/Gemini_Generated_Image_*.png
