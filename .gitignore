*.dex
release/

# Android Studio / IntelliJ (teilbare Configs bleiben getrackt)
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
